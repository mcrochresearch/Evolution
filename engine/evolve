# --- Python version check ---
check_python() {
    if ! command -v python3 &>/dev/null; then
        echo '{"error":"Python 3 is not installed. Evolution requires Python 3.7+. Install it and try again."}' >&2
        exit 1
    fi
    local ver
    ver=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")' 2>/dev/null)
    local major minor
    major=$(echo "$ver" | cut -d. -f1)
    minor=$(echo "$ver" | cut -d. -f2)
    if [[ "$major" -lt 3 ]] || { [[ "$major" -eq 3 ]] && [[ "$minor" -lt 7 ]]; }; then
        echo "{\"error\":\"Python $ver found but Evolution requires Python 3.7+. Please upgrade.\"}" >&2
        exit 1
    fi
}
